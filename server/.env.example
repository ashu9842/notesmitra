# ==========================================
# NotesMitra Server Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database (REQUIRED)
# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/notesmitra

# Frontend URL
CLIENT_URL=http://localhost:5173

# JWT Configuration (REQUIRED)
# Must be at least 32 characters long
JWT_ACCESS_SECRET=your-super-secret-access-key-minimum-32-characters-required
JWT_ACCESS_EXPIRE=2h
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-characters-required
JWT_REFRESH_EXPIRE=7d

# Redis Configuration (OPTIONAL)
# Leave empty to disable caching and background jobs
REDIS_URL=redis://localhost:6379

# Razorpay Payment Gateway (REQUIRED)
# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=dev-webhook-secret-for-development-32chars
# Razorpay X current account number for seller payouts (optional — leave blank to use manual/pending mode)
RAZORPAY_ACCOUNT_NUMBER=

# Platform User ID (OPTIONAL - for commission tracking)
# MongoDB ObjectId of the admin user that collects platform commission fees
# If not set, purchases still work but commission is not tracked in a platform wallet
PLATFORM_USER_ID=

# File Upload Configuration
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./uploads

# Cloudinary Cloud Storage (OPTIONAL - for production)
# Set USE_CLOUDINARY=true to enable cloud storage
USE_CLOUDINARY=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth (OPTIONAL - enables "Continue with Google" button)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Gemini AI (OPTIONAL)
# GEMINI_API_KEY=

# ==========================================
# Production Notes
# ==========================================
# 1. Generate cryptographically secure secrets:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 2. Never commit .env files to version control
#
# 3. Use .env.production for production environment
#
# 4. Ensure REDIS_URL is configured in production for:
#    - Response caching
#    - Background job processing
#    - Rate limiting
#
# 5. Critical secrets must be set in production:
#    - JWT_ACCESS_SECRET
#    - JWT_REFRESH_SECRET
#    - RAZORPAY_WEBHOOK_SECRET
#    - MONGODB_URI
