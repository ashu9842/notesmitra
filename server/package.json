{
  "name": "notesmitra-backend",
  "version": "1.0.0",
  "description": "NotesMitra MERN Stack Backend",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "predev": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$processId = (Get-NetTCPConnection -LocalPort 5000 -ErrorAction SilentlyContinue | Select-Object -First 1 -ExpandProperty OwningProcess); if ($processId) { Stop-Process -Id $processId -Force; Write-Host 'Killed process' $processId 'on port 5000' } else { Write-Host 'No process is using port 5000' }\"",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
    "create-admin": "node scripts/create-admin.js"
  },
  "keywords": [
    "notesmitra",
    "notes",
    "marketplace",
    "mern"
  ],
  "author": "NotesMitra",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.70.1",
    "cloudinary": "^2.9.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "crypto": "^1.0.1",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-fileupload": "^1.4.3",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "firebase-admin": "^13.7.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.23.0",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "razorpay": "^2.9.2",
    "redis": "^4.7.1",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
